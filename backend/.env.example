# WishCraft Backend Environment Configuration
PROJECT_NAME="WishCraft API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Database Connection (PostgreSQL default, SQLite fallback supported)
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/wishcraft"
# SQLite Alternative for testing or isolated environments:
# DATABASE_URL="sqlite:///./wishcraft.db"

# Security & Authentication
SECRET_KEY="wishcraft-super-secret-development-key-change-in-production-min32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Frontend & CORS
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Upload Storage (options: local, cloudinary, s3)
STORAGE_BACKEND="local"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5

# External Services (Optional - configured via env when credentials available)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# AI Message Generation (Optional - OpenAI or Gemini API Key)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
AI_PROVIDER="fallback"

# SMTP / Transactional Email (Optional)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="noreply@wishcraft.app"

